diff --git a/app/android/app/src/main/kotlin/io/github/ccch1mneyyy/dsh_app/rootexec/RootExec.kt b/app/android/app/src/main/kotlin/io/github/ccch1mneyyy/dsh_app/rootexec/RootExec.kt
