From f560a7d2b23e83f011174bced0f2e775e697e249 Mon Sep 17 00:00:00 2001
From: Wrm <65333331+wklcoca@users.noreply.github.com>
Date: Mon, 9 Nov 2026 09:57:43 +0800
Subject: [PATCH 15/18] root-exec: allow uid 0 peer (root-mode proot) on bridge

---
 .../kotlin/io/github/ccch1mneyyy/dsh_app/phone/PhoneBridge.kt | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/app/android/app/src/main/kotlin/io/github/ccch1mneyyy/dsh_app/phone/PhoneBridge.kt b/app/android/app/src/main/kotlin/io/github/ccch1mneyyy/dsh_app/phone/PhoneBridge.kt
index 5fe8682..13a524b 100644
--- a/app/android/app/src/main/kotlin/io/github/ccch1mneyyy/dsh_app/phone/PhoneBridge.kt
+++ b/app/android/app/src/main/kotlin/io/github/ccch1mneyyy/dsh_app/phone/PhoneBridge.kt
@@ -141,7 +141,7 @@ class PhoneBridge(
             } catch (_: Exception) {
                 -1
             }
-            if (uid != Process.myUid()) {
+            if (uid != Process.myUid() && uid != 0) { // root-mode proot runs as uid 0
                 log("[dsh-app] phone bridge: refused a connection from uid $uid")
                 runCatching { sock.close() }
                 continue
@@ -163,7 +163,7 @@ class PhoneBridge(
                 return
             }
             val uid = loopbackPeerUid(sock.port, s.localPort)
-            if (uid != null && uid != Process.myUid()) {
+            if (uid != null && uid != Process.myUid() && uid != 0) { // root-mode proot runs as uid 0
                 log("[dsh-app] phone bridge: refused a tcp connection from uid $uid")
                 runCatching { sock.close() }
                 continue
